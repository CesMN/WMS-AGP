# Copiar a .env en el backend de la INSTANCIA DE PRUEBAS (no reemplazar la producción).
# Ajustar BASE_PATH al subpath que defina en cPanel → Node.js (ej. /wms-v2).

NODE_ENV=production
SERVE_FRONTEND=1
PORT=5000

# Misma URL base que en cPanel "Application URL" (sin dominio)
BASE_PATH=/wms-v2

DB_HOST=localhost
DB_PORT=5432
DB_NAME=springv1_wms_dbv2
DB_USER=springv1_cMoran
DB_PASSWORD=cambiar_por_clave_postgres

JWT_SECRET=cambiar_por_cadena_larga_aleatoria
