PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wms_db
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=tu_secreto_jwt_muy_seguro_aqui

# Orígenes permitidos (CORS), separados por coma. En producción conviene definirlos (ej. https://app.midominio.com).
# CORS_ORIGIN=http://localhost:5173,http://localhost:5000
#
# Detrás de proxy inverso (nginx, etc.): activar para que el rate limit use la IP real del cliente.
# TRUST_PROXY=1
#
# Máximo de peticiones a /api/auth por IP cada 15 minutos (login / refresh).
# AUTH_RATE_LIMIT_MAX=30

# development = solo API; production o SERVE_FRONTEND=1 = sirve también el frontend compilado
NODE_ENV=development
# SERVE_FRONTEND=1
